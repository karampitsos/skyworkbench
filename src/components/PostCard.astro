---
import { Image } from 'astro:assets';
import { lurl, t, type Lang } from '../i18n';
import { formatDate, postSlug, readingMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
  lang?: Lang;
}
const { post, lang = 'en' } = Astro.props;
const { title, description, date, cover, coverAlt } = post.data;
const T = t(lang);
---

<a class:list={['register-row', cover && 'has-thumb']} href={lurl(lang, `/posts/${postSlug(post)}/`)}>
  <div class="body">
    <h3>{title}</h3>
    <div class="when"><time datetime={date.toISOString()}>{formatDate(date, lang)}</time> · {readingMinutes(post)} {T.minRead}</div>
    <p>{description}</p>
  </div>
  {cover && <Image class="thumb" src={cover} alt={coverAlt} width={300} height={200} loading="lazy" />}
</a>
