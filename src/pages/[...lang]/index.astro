---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, entryNumbers } from '../../lib/posts';
import { langPaths, toLang, lurl, t } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const T = t(lang);
const posts = await getPosts(lang);
const numbers = entryNumbers(posts, T.entry);

const S = {
  en: {
    eyebrow: 'from the workbench',
    lead: 'Hands-on astronomy for people who would rather build the thing than read about it. Every project is written up so you can repeat it: the goal, what it took, what happened, and the files to try it yourself.',
    open: 'Open the logbook ↓',
    about: 'About the bench',
    deskLabel: "A handwritten note working out a camera's field of view",
    noteTitle: 'Field of view of my camera?',
    lens: 'lens',
    sensor: 'sensor',
    moons: '≈ 2.6 full Moons across!',
    logbook: 'Logbook',
    empty: 'No. 1 is on the bench. Coming soon.',
  },
  el: {
    eyebrow: 'από τον πάγκο εργασίας',
    lead: 'Αστρονομία στην πράξη, για όσους προτιμούν να φτιάξουν κάτι παρά να διαβάσουν γι’ αυτό. Κάθε έργο είναι γραμμένο ώστε να μπορείς να το επαναλάβεις: ο στόχος, τι χρειάστηκε, τι έγινε και τα αρχεία για να το δοκιμάσεις κι εσύ.',
    open: 'Άνοιξε το ημερολόγιο ↓',
    about: 'Σχετικά με τον πάγκο',
    deskLabel: 'Μια χειρόγραφη σημείωση που υπολογίζει το οπτικό πεδίο μιας κάμερας',
    noteTitle: 'Οπτικό πεδίο της κάμεράς μου;',
    lens: 'φακός',
    sensor: 'αισθητήρας',
    moons: '≈ 2,6 πανσέληνοι σε πλάτος!',
    logbook: 'Ημερολόγιο',
    empty: 'Το Αρ. 1 είναι στον πάγκο. Έρχεται σύντομα.',
  },
}[lang];
---

<Base lang={lang}>
  <div class="wrap">
    <section class="hero">
      <div>
        <div class="eyebrow">{S.eyebrow}</div>
        <h1>{T.tagline}</h1>
        <p class="lead">{S.lead}</p>
        <a class="btn primary" href="#log">{S.open}</a>
        <a class="btn" href={lurl(lang, '/about/')}>{S.about}</a>
      </div>

      <div class="desk" aria-label={S.deskLabel}>
        <div class="coffee-ring" aria-hidden="true"></div>
        <div class="note">
          <span class="tape" aria-hidden="true"></span>
          <span class="title">{S.noteTitle}</span>
          <svg viewBox="0 0 340 122" aria-hidden="true">
            <path class="pen" d="M8 60 H300" stroke-dasharray="5 6" opacity=".55" />
            <path class="pen" d="M60 19 C 70 34, 70 86, 60 101 C 50 86, 50 34, 60 19 Z" />
            <path class="pen" d="M270 29 C 271 50, 269 70, 270 91" />
            <path class="pen" d="M270 30 L60 60 L18 66" />
            <path class="pen" d="M270 90 L60 60 L18 54" />
            <path class="pen-red" d="M93.7 55.2 A34 34 0 0 1 93.7 64.8" />
            <text class="pen-text" x="101" y="67">θ</text>
            <path class="pen" d="M64 112 H266 M64 112 l8 -4 M64 112 l8 4 M266 112 l-8 -4 M266 112 l-8 4" />
            <text class="pen-text" x="160" y="108">f</text>
            <path class="pen" d="M280 31 q6 0 6 6 v17 q0 6 5 6 q-5 0 -5 6 v17 q0 6 -6 6" />
            <text class="pen-text" x="296" y="66">d</text>
            <text class="pen-text" x="24" y="32" style="font-size:16px">{S.lens}</text>
            <text class="pen-text" x="236" y="20" style="font-size:16px">{S.sensor}</text>
          </svg>
          <span class="eq">tan(θ/2) = d / 2f</span>
          <span class="eq big">θ = 2·arctan(d / 2f)</span>
          <span class="eq big">&nbsp;&nbsp;≈ 57.3° × d / f</span>
          <span class="eq">APS-C: d = 23.5 mm, f = 1000 mm</span>
          <span class="eq">θ ≈ 57.3 × 23.5 / 1000 ≈ <span class="circled">1.35°</span></span>
          <span class="aside">{S.moons}</span>
        </div>
      </div>
    </section>

    <section class="section" id="log">
      <div class="paper notebook">
        <div class="heading">{S.logbook}</div>
        {
          posts.length ? (
            posts.map((p) => <PostCard post={p} no={numbers.get(p.id)} lang={lang} />)
          ) : (
            <p class="empty">{S.empty}</p>
          )
        }
      </div>
    </section>

  </div>
</Base>
