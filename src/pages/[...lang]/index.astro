---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { langPaths, toLang, lurl, t } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const T = t(lang);
const posts = await getPosts(lang);

const S = {
  en: {
    lead: "I'm Nikos, a software engineer and physicist. Sky Workbench is my logbook of astronomy adventures, from telescope builds to code and data, shared with anyone curious: to learn from, to try, or just to enjoy the ride.",
    open: 'See the projects ↓',
    about: 'About me',
    logbook: 'Projects',
    empty: 'No. 1 is on the bench. Coming soon.',
  },
  el: {
    lead: 'Είμαι ο Νίκος, μηχανικός λογισμικού και φυσικός. Το Sky Workbench είναι το ημερολόγιο των αστρονομικών μου περιπετειών, από κατασκευές τηλεσκοπίων μέχρι κώδικα και δεδομένα, για όποιον είναι περίεργος: για να μάθει, να δοκιμάσει ή απλώς να απολαύσει το ταξίδι.',
    open: 'Δες τα projects ↓',
    about: 'Σχετικά με μένα',
    logbook: 'Projects',
    empty: 'Το Αρ. 1 είναι στον πάγκο. Έρχεται σύντομα.',
  },
}[lang];
---

<Base lang={lang}>
  <div class="wrap">
    <section class="hero">
      <div>
        <h1>{T.tagline}</h1>
        <p class="lead">{S.lead}</p>
        <a class="btn primary" href="#log">{S.open}</a>
        <a class="btn" href={lurl(lang, '/about/')}>{S.about}</a>
      </div>
    </section>

    <section class="section" id="log">
      <div class="paper notebook">
        <div class="heading">{S.logbook}</div>
        {
          posts.length ? (
            posts.map((p) => <PostCard post={p} lang={lang} />)
          ) : (
            <p class="empty">{S.empty}</p>
          )
        }
      </div>
    </section>

  </div>
</Base>
