---
import { url } from '../../site';
import Base from '../../layouts/Base.astro';
import { langPaths, toLang } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = toLang(Astro.params.lang);
const S = {
  en: {
    title: 'Search',
    description: 'Search every Sky Workbench project.',
    intro: 'Search every post: parts, code, numbers, mistakes. It runs entirely in your browser.',
    noscript: 'Search needs JavaScript.',
    placeholder: 'Search the projects… e.g. belt, NEMA 17, pulley',
  },
  el: {
    title: 'Αναζήτηση',
    description: 'Αναζήτηση σε όλα τα projects του Sky Workbench.',
    intro: 'Αναζήτηση σε όλα τα άρθρα: εξαρτήματα, κώδικας, αριθμοί, λάθη. Τρέχει εξ ολοκλήρου στον browser σου.',
    noscript: 'Η αναζήτηση χρειάζεται JavaScript.',
    placeholder: 'Αναζήτηση στα projects… π.χ. ιμάντας, NEMA 17, τροχαλία',
  },
}[lang];
---

<Base title={S.title} description={S.description} lang={lang}>
  <link slot="head" href={url('/pagefind/pagefind-ui.css')} rel="stylesheet" />
  <div class="wrap">
    <div class="page-title">
      <h1>{S.title}</h1>
      <p>{S.intro}</p>
    </div>
    <section class="paper page-sheet">
      <div id="search"></div>
      <noscript><p class="empty">{S.noscript}</p></noscript>
      <p id="search-dev-note" class="empty" hidden>
        Search index is created by <code>npm run build</code>. It won't appear under <code>npm run dev</code>;
        use <code>npm run build &amp;&amp; npm run preview</code> to try it.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ pagefindJs: url('/pagefind/pagefind-ui.js'), placeholder: S.placeholder }}>
    (function () {
      var s = document.createElement('script');
      s.src = pagefindJs;
      s.onload = function () {
        var ui = new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          autofocus: true,
          // Pagefind keeps one index per page language (from <html lang>), so Greek pages search Greek posts.
          translations: { placeholder: placeholder },
        });
        // Allow linking to a search: /search/?q=stepper
        var q = new URLSearchParams(location.search).get('q');
        if (q) ui.triggerSearch(q);
      };
      s.onerror = function () {
        document.getElementById('search-dev-note').hidden = false;
      };
      document.head.appendChild(s);
    })();
  </script>
</Base>
