---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, url } from '../site';
import { getPosts, entryNumbers } from '../lib/posts';

const posts = await getPosts();
const numbers = entryNumbers(posts);
---

<Base>
  <div class="wrap">
    <section class="hero">
      <div>
        <div class="eyebrow">from the workbench</div>
        <h1>{SITE.tagline}</h1>
        <p class="lead">
          A build log of hands-on astronomy: upgrading telescopes and mounts, writing the code that drives them,
          and working with the data they collect. Real parts lists, real costs, and what went wrong.
        </p>
        <a class="btn primary" href="#log">Open the logbook ↓</a>
        <a class="btn" href={url('/about/')}>About the bench</a>
      </div>

      <div class="desk" aria-label="A handwritten note working out a camera's field of view, next to a telescope mirror and a pencil">
        <div class="coffee-ring" aria-hidden="true"></div>
        <div class="mirror" aria-hidden="true"></div>
        <div class="note">
          <span class="tape" aria-hidden="true"></span>
          <span class="title">Field of view of my camera?</span>
          <svg viewBox="0 0 340 122" aria-hidden="true">
            <path class="pen" d="M8 60 H300" stroke-dasharray="5 6" opacity=".55" />
            <path class="pen" d="M60 19 C 70 34, 70 86, 60 101 C 50 86, 50 34, 60 19 Z" />
            <path class="pen" d="M270 29 C 271 50, 269 70, 270 91" />
            <path class="pen" d="M270 30 L60 60 L18 66" />
            <path class="pen" d="M270 90 L60 60 L18 54" />
            <path class="pen-red" d="M93.7 55.2 A34 34 0 0 1 93.7 64.8" />
            <text class="pen-text" x="101" y="67">θ</text>
            <path class="pen" d="M64 112 H266 M64 112 l8 -4 M64 112 l8 4 M266 112 l-8 -4 M266 112 l-8 4" />
            <text class="pen-text" x="160" y="108">f</text>
            <path class="pen" d="M280 31 q6 0 6 6 v17 q0 6 5 6 q-5 0 -5 6 v17 q0 6 -6 6" />
            <text class="pen-text" x="296" y="66">d</text>
            <text class="pen-text" x="24" y="32" style="font-size:16px">lens</text>
            <text class="pen-text" x="236" y="20" style="font-size:16px">sensor</text>
          </svg>
          <span class="eq">tan(θ/2) = d / 2f</span>
          <span class="eq big">θ = 2·arctan(d / 2f)</span>
          <span class="eq big">&nbsp;&nbsp;≈ 57.3° × d / f</span>
          <span class="eq">APS-C: d = 23.5 mm, f = 1000 mm</span>
          <span class="eq">θ ≈ 57.3 × 23.5 / 1000 ≈ <span class="circled">1.35°</span></span>
          <span class="aside">≈ 2.6 full Moons across!</span>
        </div>
        <svg class="pencil" viewBox="0 0 220 26" aria-hidden="true">
          <rect x="0" y="4" width="20" height="18" rx="4" fill="#e48a83" />
          <rect x="18" y="3" width="18" height="20" fill="#bdb6a8" />
          <path d="M22 3v20M27 3v20M32 3v20" stroke="#8e877a" stroke-width="1" />
          <rect x="36" y="3" width="140" height="20" fill="#e3a92e" />
          <rect x="36" y="3" width="140" height="6" fill="#f2c754" />
          <rect x="36" y="17" width="140" height="6" fill="#c08a1c" />
          <path d="M176 3 L208 13 L176 23 Z" fill="#e6c79c" />
          <path d="M198 10 L208 13 L198 16 Z" fill="#3b3631" />
        </svg>
      </div>
    </section>

    <section class="section" id="log">
      <div class="paper notebook">
        <div class="heading">Logbook</div>
        {
          posts.length ? (
            posts.map((p) => <PostCard post={p} no={numbers.get(p.id)} />)
          ) : (
            <p class="empty">No. 1 is on the bench. Coming soon.</p>
          )
        }
      </div>
    </section>

  </div>
</Base>
