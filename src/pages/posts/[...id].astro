---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../site';
import { getPosts, formatDate, slugifyTag, entryNumbers } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const numbers = entryNumbers(posts);
  return posts.map((post) => ({ params: { id: post.id }, props: { post, no: numbers.get(post.id) } }));
}

const { post, no } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const hasSpec = d.goal || d.cost || d.time || d.difficulty || d.materials.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  keywords: d.tags.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Base title={d.title} description={d.description} type="article" ogImage={post.id}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />
  <article class="wrap post" data-pagefind-body>
    <div class="paper sheet">
    <header>
      <div class="eyebrow">{no} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></div>
      <h1>{d.title}</h1>
      <div class="dim" aria-hidden="true"></div>
      <p class="desc">{d.description}</p>
    </header>

    {
      hasSpec && (
        <aside class="titleblock" aria-label="Project summary">
          {d.goal && (<div class="cell"><span class="label">Goal</span><div class="v">{d.goal}</div></div>)}
          {(d.difficulty || d.time || d.cost) && (
            <div class="row">
              {d.difficulty && (<div class="cell"><span class="label">Difficulty</span><div class="v">{d.difficulty}</div></div>)}
              {d.time && (<div class="cell"><span class="label">Time</span><div class="v">{d.time}</div></div>)}
              {d.cost && (<div class="cell"><span class="label">Cost</span><div class="v">{d.cost}</div></div>)}
            </div>
          )}
          {d.materials.length > 0 && (
            <div class="cell">
              <span class="label">Bill of materials</span>
              <ol>{d.materials.map((m) => <li>{m}</li>)}</ol>
            </div>
          )}
        </aside>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      d.files.length > 0 && (
        <section class="downloads">
          <h2>Files</h2>
          {d.files.map((f) => <a href={f.href}>{f.label}</a>)}
        </section>
      )
    }

    {
      d.tags.length > 0 && (
        <div class="meta" style="margin-top:28px">
          {d.tags.map((t) => <a class="pill" href={url(`/tags/${slugifyTag(t)}/`)}>#{t}</a>)}
        </div>
      )
    }
    </div>
  </article>
</Base>
