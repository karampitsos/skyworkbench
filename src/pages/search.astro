---
import { url } from '../site';
import Base from '../layouts/Base.astro';
---

<Base title="Search" description="Search every post in the Sky Workbench logbook.">
  <link slot="head" href={url('/pagefind/pagefind-ui.css')} rel="stylesheet" />
  <div class="wrap">
    <div class="page-title">
      <div class="eyebrow">look it up</div>
      <h1>Search</h1>
      <div class="dim" aria-hidden="true"></div>
      <p>Search every post: parts, code, numbers, mistakes. It runs entirely in your browser.</p>
    </div>
    <section class="paper page-sheet">
      <div id="search"></div>
      <noscript><p class="empty">Search needs JavaScript.</p></noscript>
      <p id="search-dev-note" class="empty" hidden>
        Search index is created by <code>npm run build</code>. It won't appear under <code>npm run dev</code>;
        use <code>npm run build &amp;&amp; npm run preview</code> to try it.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ pagefindJs: url('/pagefind/pagefind-ui.js') }}>
    (function () {
      var s = document.createElement('script');
      s.src = pagefindJs;
      s.onload = function () {
        var ui = new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          autofocus: true,
          translations: { placeholder: 'Search the logbook… e.g. belt, NEMA 17, pulley' },
        });
        // Allow linking to a search: /search/?q=stepper
        var q = new URLSearchParams(location.search).get('q');
        if (q) ui.triggerSearch(q);
      };
      s.onerror = function () {
        document.getElementById('search-dev-note').hidden = false;
      };
      document.head.appendChild(s);
    })();
  </script>
</Base>
