---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { SECTIONS, type SectionKey } from '../../site';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
  return (Object.keys(SECTIONS) as SectionKey[]).map((section) => ({ params: { section } }));
}

const { section } = Astro.params as { section: SectionKey };
const info = SECTIONS[section];
const posts = (await getPosts()).filter((p) => p.data.section === section);
---

<Base title={info.label} description={info.blurb}>
  <div class="wrap">
    <div class="page-title">
      <div class="eyebrow">{info.icon} Section</div>
      <h1>{info.label}</h1>
      <p>{info.blurb}</p>
    </div>
    <section class="section">
      {
        posts.length ? (
          <div class="post-list">
            {posts.map((p) => <PostCard post={p} />)}
          </div>
        ) : (
          <p class="empty">Nothing here yet. First post coming soon.</p>
        )
      }
    </section>
  </div>
</Base>
