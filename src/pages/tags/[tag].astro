---
import { url } from '../../site';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupByTag, drawingNumbers } from '../../lib/posts';

export async function getStaticPaths() {
  const all = await getPosts();
  const numbers = drawingNumbers(all);
  return [...groupByTag(all).entries()].map(([slug, t]) => ({
    params: { tag: slug },
    props: { label: t.label, posts: t.posts, numbers },
  }));
}

const { label, posts, numbers } = Astro.props;
---

<Base title={`Tag: ${label}`} description={`Posts tagged ${label} on Sky Workbench.`}>
  <div class="wrap">
    <div class="page-title">
      <div class="eyebrow">Tag</div>
      <h1>{label}</h1>
      <div class="dim" aria-hidden="true"></div>
      <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} · <a href={url('/tags/')}>all tags</a></p>
    </div>
    <section class="section">
      <div class="register">
        {posts.map((p) => <PostCard post={p} no={numbers.get(p.id)} />)}
      </div>
    </section>
  </div>
</Base>
