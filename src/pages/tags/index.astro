---
import { url } from '../../site';
import Base from '../../layouts/Base.astro';
import { getPosts, groupByTag } from '../../lib/posts';

const tags = [...groupByTag(await getPosts()).entries()].sort(
  (a, b) => b[1].posts.length - a[1].posts.length || a[1].label.localeCompare(b[1].label),
);
---

<Base title="Tags" description="Browse Sky Workbench posts by topic.">
  <div class="wrap">
    <div class="page-title">
      <div class="eyebrow">Browse</div>
      <h1>Tags</h1>
      <div class="dim" aria-hidden="true"></div>
    </div>
    <section class="paper page-sheet">
      {
        tags.length ? (
          <div class="meta" style="gap:10px">
            {tags.map(([slug, t]) => (
              <a class="pill" href={url(`/tags/${slug}/`)}>
                {t.label} · {t.posts.length}
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">No tags yet.</p>
        )
      }
    </section>
  </div>
</Base>
