---
import { url } from '../../site';
import Base from '../../layouts/Base.astro';
---

<Base title="Tools" description="Small interactive calculators for telescope and imaging setups.">
  <div class="wrap">
    <div class="page-title">
      <div class="eyebrow">Tools</div>
      <h1>Calculators</h1>
      <div class="dim" aria-hidden="true"></div>
      <p>Small, fast, and client-side only. No data leaves your browser.</p>
    </div>
    <section class="section">
      <div class="grid cols-2">
        <a class="card" href={url('/tools/field-of-view/')}>
          <div class="icon">◎</div>
          <h3>Field-of-view calculator</h3>
          <p>Telescope + camera → image scale, field of view, and a framing preview.</p>
        </a>
      </div>
    </section>
  </div>
</Base>
